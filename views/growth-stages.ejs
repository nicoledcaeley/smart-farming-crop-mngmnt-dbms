<%- include('partials/header', { pageTitle: 'Growth Stages' }) %>

<main class="page" id="main">
    <h1>Crop Growth Stages</h1>
    <p>Manage the growth stages of each crop.</p>

    <h2>Add Growth Stage</h2>

    <form action="/growth-stages" method="POST">
        <div class="field">
            <label for="crop_id">Crop:</label>
            <select name="crop_id" id="crop_id" required>
                <option value="">Select a crop</option>
                <% crops.forEach(function(crop) { %>
                    <option value="<%= crop.crop_id %>">
                        <%= crop.crop_name %>
                    </option>
                <% }); %>
            </select>
        </div>

        <div class="field">
            <label for="stage_name">Stage Name:</label>
            <input type="text" id="stage_name" name="stage_name" required>
        </div>

        <div class="field">
            <label for="stage_order">Stage Order:</label>
            <input type="number" id="stage_order" name="stage_order" min="1" required>
        </div>

        <div class="field">
            <label for="start_day">Start Day:</label>
            <input type="number" id="start_day" name="start_day" min="0" required>
        </div>

        <div class="field">
            <label for="end_day">End Day:</label>
            <input type="number" id="end_day" name="end_day" min="0" required>
        </div>

        <button type="submit">Add Growth Stage</button>
    </form>

    <h2>Existing Growth Stages</h2>

    <div class="table-wrap">
        <table>
            <tr>
                <th>Crop</th>
                <th>Stage</th>
                <th>Order</th>
                <th>Start Day</th>
                <th>End Day</th>
            </tr>

            <% stages.forEach(function(stage) { %>
                <tr>
                    <td><%= stage.crop_name %></td>
                    <td><%= stage.stage_name %></td>
                    <td><%= stage.stage_order %></td>
                    <td><%= stage.start_day %></td>
                    <td><%= stage.end_day %></td>
                </tr>
            <% }); %>
        </table>
    </div>
</main>

<%- include('partials/footer') %>
