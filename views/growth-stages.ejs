
<%- include('partials/header', { pageTitle: 'Growth Stages' }) %>

<main class="page" id="main">
    <h1>Crop Growth Stages</h1>
    <p>Manage the growth stages of each crop.</p>

    <h2>Add Growth Stage</h2>

    <form action="/growth-stages" method="POST">
        <div class="field">
            <label for="crop_id">Crop:</label>
            <select name="crop_id" id="crop_id" required>
                <option value="">Select a crop</option>
                <% crops.forEach(function(crop) { %>
                    <option value="<%= crop.crop_id %>">
                        <%= crop.crop_name %>
                    </option>
                <% }); %>
            </select>
        </div>

        <div class="field">
            <label for="stage_name">Stage Name:</label>
            <input type="text" id="stage_name" name="stage_name" required>
        </div>

        <div class="field">
            <label for="stage_order">Stage Order:</label>
            <input type="number" id="stage_order" name="stage_order" min="1" required>
        </div>

        <div class="field">
            <label for="start_day">Start Day:</label>
            <input type="number" id="start_day" name="start_day" min="0" required>
        </div>

        <div class="field">
            <label for="end_day">End Day:</label>
            <input type="number" id="end_day" name="end_day" min="0" required>
        </div>

        <button type="submit">Add Growth Stage</button>
    </form>

    <h2>Existing Growth Stages</h2>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Crop</th>
                    <th>Stage</th>
                    <th>Order</th>
                    <th>Start Day</th>
                    <th>End Day</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                <% stages.forEach(function(stage) { %>
                    <tr>
                        <td><%= stage.crop_name %></td>
                        <td><%= stage.stage_name %></td>
                        <td><%= stage.stage_order %></td>
                        <td><%= stage.start_day %></td>
                        <td><%= stage.end_day %></td>
                        <td>
                            <button
                                type="button"
                                onclick="openEditStage(this)"
                                data-id="<%= stage.stage_id %>"
                                data-crop-id="<%= stage.crop_id %>"
                                data-name="<%= stage.stage_name %>"
                                data-order="<%= stage.stage_order %>"
                                data-start="<%= stage.start_day %>"
                                data-end="<%= stage.end_day %>">
                                Edit
                            </button>

                            <form
                                action="/growth-stages/<%= stage.stage_id %>/delete"
                                method="POST"
                                style="display:inline"
                                onsubmit="return confirm('Are you sure you want to delete this growth stage?');">
                                <button type="submit">Delete</button>
                            </form>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>

    <div id="editStageModal"
         style="display:none; position:fixed; inset:0; z-index:1000;
                background:rgba(0,0,0,0.5); align-items:center;
                justify-content:center; padding:20px;">

        <div style="background:white; color:#222; padding:24px;
                    border-radius:8px; width:100%; max-width:450px;
                    max-height:90vh; overflow:auto;">

            <h2>Edit Growth Stage</h2>

            <form id="editStageForm" method="POST">
                <div class="field">
                    <label for="edit_crop_id">Crop:</label>
                    <select name="crop_id" id="edit_crop_id" required>
                        <% crops.forEach(function(crop) { %>
                            <option value="<%= crop.crop_id %>">
                                <%= crop.crop_name %>
                            </option>
                        <% }); %>
                    </select>
                </div>

                <div class="field">
                    <label for="edit_stage_name">Stage Name:</label>
                    <input type="text" name="stage_name"
                           id="edit_stage_name" required>
                </div>

                <div class="field">
                    <label for="edit_stage_order">Stage Order:</label>
                    <input type="number" name="stage_order"
                           id="edit_stage_order" min="1" required>
                </div>

                <div class="field">
                    <label for="edit_start_day">Start Day:</label>
                    <input type="number" name="start_day"
                           id="edit_start_day" min="0" required>
                </div>

                <div class="field">
                    <label for="edit_end_day">End Day:</label>
                    <input type="number" name="end_day"
                           id="edit_end_day" min="0" required>
                </div>

                <button type="submit">Save Changes</button>
                <button type="button" onclick="closeEditStage()">Cancel</button>
            </form>
        </div>
    </div>
</main>

<script>
    function openEditStage(button) {
        const id = button.dataset.id;
        const modal = document.getElementById('editStageModal');
        const form = document.getElementById('editStageForm');

        form.action = '/growth-stages/' + id + '/update';

        document.getElementById('edit_crop_id').value =
            button.dataset.cropId;
        document.getElementById('edit_stage_name').value =
            button.dataset.name;
        document.getElementById('edit_stage_order').value =
            button.dataset.order;
        document.getElementById('edit_start_day').value =
            button.dataset.start;
        document.getElementById('edit_end_day').value =
            button.dataset.end;

        modal.style.display = 'flex';
    }

    function closeEditStage() {
        document.getElementById('editStageModal').style.display = 'none';
    }

    document.getElementById('editStageModal').addEventListener('click', function(event) {
        if (event.target === this) {
            closeEditStage();
        }
    });
</script>

<%- include('partials/footer') %>