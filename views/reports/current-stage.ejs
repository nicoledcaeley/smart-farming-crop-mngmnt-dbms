<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Current Stage per Planting Report</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            margin: 20px;
            background: #f3f7f1;
            color: #243b2a;
        }

        h1 {
            color: #246b35;
            margin-bottom: 8px;
        }

        .description {
            color: #536456;
            line-height: 1.5;
        }

        .back-link {
            display: inline-block;
            margin: 8px 0;
            color: #246b35;
        }

        .report-info {
            margin-top: 20px;
            padding: 12px 16px;
            background: #e4efdf;
            border-left: 4px solid #43865b;
            border-radius: 4px;
        }

        .table-container {
            width: 100%;
            overflow-x: auto;
            background: white;
            border-radius: 8px;
            margin-top: 18px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
        }

        table {
            width: 100%;
            min-width: 750px;
            background: white;
            border-collapse: collapse;
        }

        th, td {
            border-bottom: 1px solid #e0e6dd;
            padding: 12px 14px;
            text-align: left;
            vertical-align: middle;
        }

        th {
            background: #dcebd8;
            color: #244b2c;
            font-size: 13px;
            white-space: nowrap;
        }

        tbody tr:hover {
            background: #f7faf5;
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        .center {
            text-align: center;
        }

        .date-cell {
            white-space: nowrap;
        }

        .stage-name {
            font-weight: 600;
            color: #315b39;
        }

        .status {
            display: inline-block;
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 12px;
            font-weight: bold;
            white-space: nowrap;
        }

        .status-active {
            color: #216b3b;
            background: #e0f3e5;
        }

        .status-harvested {
            color: #2457a6;
            background: #e2ecff;
        }

        .status-pending {
            color: #895b08;
            background: #fff1cc;
        }

        .status-default {
            color: #4b5563;
            background: #e9edf0;
        }

        .empty {
            background: white;
            padding: 20px;
            border-radius: 8px;
            border: 1px solid #e0e6dd;
        }

        @media (max-width: 600px) {
            body {
                margin: 12px;
            }

            h1 {
                font-size: 23px;
            }

            th, td {
                padding: 10px;
            }
        }
    </style>
</head>

<body>
    <h1>Current Stage per Planting Report</h1>

    <p class="description">
        This report displays each planting, its crop, planting date,
        expected harvest date, current growth stage, and status.
    </p>

    <p>
        <a class="back-link" href="/">← Back to Home</a>
    </p>

    <%
        function formatReportDate(value) {
            if (value === null || value === undefined || value === '') {
                return 'Not set';
            }

            const raw = String(value);

            // Preserve date-only values without timezone conversion.
            const dateOnlyMatch = raw.match(/^(\d{4}-\d{2}-\d{2})/);

            if (dateOnlyMatch) {
                return dateOnlyMatch[1];
            }

            const date = value instanceof Date ? value : new Date(value);

            if (Number.isNaN(date.getTime())) {
                return raw;
            }

            const year = date.getFullYear();
            const month = String(date.getMonth() + 1).padStart(2, '0');
            const day = String(date.getDate()).padStart(2, '0');

            return `${year}-${month}-${day}`;
        }

        function getStatusClass(status) {
            const normalized = String(status || '').toLowerCase();

            if (normalized === 'active') return 'status-active';
            if (normalized === 'harvested') return 'status-harvested';
            if (normalized === 'pending') return 'status-pending';

            return 'status-default';
        }
    %>

    <% if (plantings.length === 0) { %>
        <p class="empty">No planting records found.</p>
    <% } else { %>

        <p class="report-info">
            <strong>Total Plantings:</strong> <%= plantings.length %>
        </p>

        <div class="table-container">
            <table>
                <thead>
                    <tr>
                        <th class="center">Planting ID</th>
                        <th>Crop</th>
                        <th>Planting Date</th>
                        <th>Expected Harvest</th>
                        <th>Current Stage</th>
                        <th class="center">Stage Order</th>
                        <th>Status</th>
                    </tr>
                </thead>

                <tbody>
                    <% plantings.forEach(planting => { %>
                        <tr>
                            <td class="center">
                                <%= planting.planting_id %>
                            </td>

                            <td>
                                <%= planting.crop_name || 'Unknown crop' %>
                            </td>

                            <td class="date-cell">
                                <%= formatReportDate(planting.planting_date) %>
                            </td>

                            <td class="date-cell">
                                <%= formatReportDate(planting.expected_harvest_date) %>
                            </td>

                            <td class="stage-name">
                                <%= planting.current_stage || 'Not assigned' %>
                            </td>

                            <td class="center">
                                <%= planting.stage_order ?? '—' %>
                            </td>

                            <td>
                                <span class="status <%= getStatusClass(planting.status) %>">
                                    <%= planting.status || 'Unknown' %>
                                </span>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    <% } %>
</body>
</html>