
<%- include('../partials/header') %>

<div class="container">
    <h1>Users, Roles, and Farms Report</h1>

    <p>List of users, their assigned roles, and farms.</p>

    <table>
        <thead>
            <tr>
                <th>User ID</th>
                <th>Full Name</th>
                <th>Email</th>
                <th>Role</th>
                <th>Farm</th>
            </tr>
        </thead>

        <tbody>
            <% report.forEach(user => { %>
                <tr>
                    <td><%= user.user_id %></td>
                    <td><%= user.full_name %></td>
                    <td><%= user.email %></td>
                    <td><%= user.role_name %></td>
                    <td><%= user.farm_name || 'Not Assigned' %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>

    <br>
    <a href="/users">Back to Users</a>
</div>

<%- include('../partials/footer') %>
