<%- include('../partials/header', { pageTitle: 'Idle Fields Report' }) %>

<main class="page" id="main">
    <h1>Idle Fields Report</h1>

    <p>
        This report displays fields that do not have any active planting records.
    </p>

    <% if (fields.length === 0) { %>

        <p class="empty">No idle fields found.</p>

    <% } else { %>

        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>Field ID</th>
                        <th>Field Name</th>
                        <th>Farm Name</th>
                    </tr>
                </thead>

                <tbody>

                    <% fields.forEach(field => { %>

                        <tr>
                            <td><%= field.field_id %></td>
                            <td><%= field.field_name %></td>
                            <td><%= field.farm_name %></td>
                        </tr>

                    <% }) %>

                </tbody>
            </table>
        </div>

    <% } %>
</main>

<%- include('../partials/footer') %>
