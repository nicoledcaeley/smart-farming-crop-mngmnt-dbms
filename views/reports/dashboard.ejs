<!DOCTYPE html>
<html>
<head>
  <title>Smart Farming - Dashboard</title>
</head>
<body>
  <h1>Smart Farming — Reports & Dashboard</h1>
  <nav>
    <a href="/dashboard">Dashboard</a> | 
    <a href="/pest-reports">Pest Reports</a> | 
    <a href="/weather-logs">Weather Logs</a>
  </nav>

  <h2>Pest Reports Summary per Crop (RIGHT JOIN Query)</h2>
  <table border="1" cellpadding="8">
    <thead>
      <tr>
        <th>Crop Name</th>
        <th>Category</th>
        <th>Total Pest Reports</th>
        <th>Latest Report Date</th>
      </tr>
    </thead>
    <tbody>
      <% pestSummary.forEach(item => { %>
        <tr>
          <td><%= item.crop_name %></td>
          <td><%= item.category %></td>
          <td><strong><%= item.total_pest_reports %></strong></td>
          <td><%= item.latest_report_date ? new Date(item.latest_report_date).toLocaleDateString() : 'None' %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</body>
</html>