<%- include('partials/header', { pageTitle: 'Sensor readings' }) %>

<main class="page" id="main">
    <h1>Sensor readings</h1>
    <p>Record a reading for a field. Readings outside a crop's thresholds raise an alert.</p>

    <%
        const metricLabel = { soil_moisture: 'Soil moisture', temperature: 'Temperature', ph: 'pH' };
        const fieldList = (typeof fields !== 'undefined' && fields) ? fields : [];
    %>

    <h2>Add a reading</h2>

    <form action="/readings" method="POST">
        <div class="field">
            <label for="field_id">Field</label>
            <select id="field_id" name="field_id" required>
                <option value="">Select a field</option>
                <% fieldList.forEach((field) => { %>
                    <option value="<%= field.field_id %>"><%= field.field_name %></option>
                <% }); %>
            </select>
        </div>

        <div class="field">
            <label for="metric">Metric</label>
            <select id="metric" name="metric" required>
                <option value="soil_moisture">Soil moisture</option>
                <option value="temperature">Temperature</option>
                <option value="ph">pH</option>
            </select>
        </div>

        <div class="field">
            <label for="value">Value</label>
            <input type="number" step="0.01" id="value" name="value" required>
        </div>

        <button type="submit">Add reading</button>
    </form>

    <h2>Recent readings</h2>

    <% if (readings && readings.length) { %>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Field</th>
                        <th>Metric</th>
                        <th>Value</th>
                        <th>Recorded</th>
                    </tr>
                </thead>
                <tbody>
                    <% readings.forEach((reading) => { %>
                        <tr>
                            <td><%= reading.reading_id %></td>
                            <td><%= reading.field_name || reading.field_id %></td>
                            <td><%= metricLabel[reading.metric] || reading.metric %></td>
                            <td><%= reading.value %></td>
                            <td><%= new Date(reading.reading_time).toLocaleString() %></td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    <% } else { %>
        <p class="empty">No readings yet.</p>
    <% } %>
</main>

<%- include('partials/footer') %>
