<!DOCTYPE html>
<html>
<head>
<title>Sensor Readings</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
<div class="container mt-4">
<h3>Sensor Readings</h3>

<form method="POST" action="/readings" class="row g-2 mb-4">
<div class="col-md-3">
<select name="field_id" class="form-control" required>
<option value="">Select Field</option>
<% if (typeof fields !== 'undefined') { %>
  <% fields.forEach(f => { %>
    <option value="<%= f.field_id %>"><%= f.field_name %></option>
  <% }) %>
<% } %>
</select>
</div>
<div class="col-md-3">
<select name="metric" class="form-control" required>
<option value="soil_moisture">soil_moisture</option>
<option value="temperature">temperature</option>
<option value="humidity">humidity</option>
</select>
</div>
<div class="col-md-2">
<input type="number" step="0.01" name="value" class="form-control" placeholder="Value" required>
</div>
<div class="col-md-2">
<button class="btn btn-primary w-100">Add</button>
</div>
</form>

<table class="table table-bordered">
<tr><th>ID</th><th>Field</th><th>Metric</th><th>Value</th><th>Date</th></tr>
<% if (!readings || readings.length === 0) { %>
<tr><td colspan="5">No readings yet</td></tr>
<% } else { %>
  <% readings.forEach(r => { %>
    <tr>
      <td><%= r.reading_id %></td>
      <td><%= r.field_name || r.field_id %></td>
      <td><%= r.metric %></td>
      <td><%= r.value %></td>
      <td><%= r.reading_time %></td>
    </tr>
  <% }) %>
<% } %>
</table>
<a href="/" class="btn btn-secondary">Back</a>
</div>
</body>
</html>
