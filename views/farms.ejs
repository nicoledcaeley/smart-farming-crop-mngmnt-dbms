<%- include('partials/header', { pageTitle: 'Farms' }) %>

<main class="page" id="main">
    <h2>Farm Management</h2>

    <h3>Add New Farm</h3>

    <form action="/farms" method="POST">
        <div class="field">
            <label for="farm_name">Farm Name:</label>
            <input type="text" id="farm_name" name="farm_name" required>
        </div>

        <div class="field">
            <label for="location">Location:</label>
            <input type="text" id="location" name="location" required>
        </div>

        <div class="field">
            <label for="total_area_ha">Total Area (hectares):</label>
            <input
                type="number"
                id="total_area_ha"
                name="total_area_ha"
                step="0.01"
                min="0.01"
                required
            >
        </div>

        <button type="submit">Add Farm</button>
    </form>

    <h3>Farm List</h3>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Farm ID</th>
                    <th>Farm Name</th>
                    <th>Location</th>
                    <th>Total Area (ha)</th>
                    <th>Date Created</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                <% if (farms.length === 0) { %>
                    <tr>
                        <td colspan="6">No farms found.</td>
                    </tr>
                <% } %>

                <% farms.forEach(function(farm) { %>
                    <tr>
                        <td><%= farm.farm_id %></td>
                        <td><%= farm.farm_name %></td>
                        <td><%= farm.location %></td>
                        <td><%= farm.total_area_ha %></td>
                        <td><%= farm.created_at ? new Date(farm.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : '—' %></td>
                        <td>
    <% if (sessionUser && ['Admin', 'Farm Manager'].includes(sessionUser.role_name)) { %>
        <a href="/farms/<%= farm.farm_id %>/edit">Edit</a>
    <% } else { %>
        —
    <% } %>
    </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
    </div>
</main>

<%- include('partials/footer') %>
