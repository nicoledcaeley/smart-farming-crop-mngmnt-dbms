<%- include('partials/header', { pageTitle: 'Something went wrong' }) %>

<main class="page" id="main">
    <div class="state">
        <div class="state__code">500</div>
        <h1>The app couldn't finish that request</h1>
        <p>This usually means the database isn't reachable. Try again in a moment. If it keeps happening, contact your system administrator.</p>
        <div class="cta-row">
            <button type="button" onclick="window.location.reload()">Try again</button>
            <a href="/" class="btn btn--ghost">Back to home</a>
        </div>
    </div>
</main>

<%- include('partials/footer') %>
