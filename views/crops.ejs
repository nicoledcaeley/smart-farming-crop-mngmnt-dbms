<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Crops Management</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 20px;
            background: #f3f7f1;
            color: #243b2a;
        }

        h1, h2 {
            color: #246b35;
        }

        form, table {
            background: white;
            padding: 16px;
            border-radius: 8px;
            margin-bottom: 24px;
        }

        input, select, button {
            padding: 10px;
            margin: 5px 0;
            width: 100%;
            box-sizing: border-box;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            border: 1px solid #ddd;
            padding: 8px;
            text-align: left;
        }

        th {
            background: #dcebd8;
        }

        .error {
            color: red;
        }
    </style>
</head>

<body>

    <h1>Crops Management</h1>

    <p><a href="/">Back to Home</a></p>

    <% if (error) { %>
        <p class="error"><%= error %></p>
    <% } %>

    <h2>Add a Crop</h2>

    <form action="/crops" method="POST">

        <label for="crop_name">Crop Name</label>
        <input
            id="crop_name"
            name="crop_name"
            maxlength="80"
            required
        >

        <label for="category">Category</label>
        <select id="category" name="category" required>
            <option value="">Select category</option>
            <option>Cereal</option>
            <option>Vegetable</option>
            <option>Fruit</option>
            <option>Legume</option>
            <option>Root crop</option>
        </select>

        <label for="days_to_maturity">Days to Maturity</label>
        <input
            id="days_to_maturity"
            name="days_to_maturity"
            type="number"
            min="1"
            step="1"
            required
        >

        <label for="expected_yield_kg_ha">
            Expected Yield (kg/ha) - Optional
        </label>
        <input
            id="expected_yield_kg_ha"
            name="expected_yield_kg_ha"
            type="number"
            min="0.01"
            step="0.01"
        >

        <button type="submit">Add Crop</button>

    </form>

    <h2>Existing Crops</h2>

    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Crop Name</th>
                <th>Category</th>
                <th>Days to Maturity</th>
                <th>Expected Yield (kg/ha)</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>

            <% crops.forEach(crop => { %>

                <tr>
                    <td><%= crop.crop_id %></td>
                    <td><%= crop.crop_name %></td>
                    <td><%= crop.category %></td>
                    <td><%= crop.days_to_maturity %></td>
                    <td>
                        <%= crop.expected_yield_kg_ha ?? 'Not specified' %>
                    </td>

                    <td>
                        <button
                            type="button"
                            onclick="document.getElementById('edit-<%= crop.crop_id %>').hidden = !document.getElementById('edit-<%= crop.crop_id %>').hidden">
                            Edit
                        </button>

                        <form
                            action="/crops/<%= crop.crop_id %>/delete"
                            method="POST"
                            onsubmit="return confirm('Delete this crop?');">

                            <button type="submit">Delete</button>

                        </form>
                    </td>
                </tr>

                <tr id="edit-<%= crop.crop_id %>" hidden>
                    <td colspan="6">

                        <form
                            action="/crops/<%= crop.crop_id %>/update"
                            method="POST">

                            <label>Crop Name</label>
                            <input
                                name="crop_name"
                                value="<%= crop.crop_name %>"
                                maxlength="80"
                                required
                            >

                            <label>Category</label>
                            <select name="category" required>

                                <% ['Cereal', 'Vegetable', 'Fruit', 'Legume', 'Root crop'].forEach(category => { %>

                                    <option
                                        value="<%= category %>"
                                        <%= category === crop.category ? 'selected' : '' %>>
                                        <%= category %>
                                    </option>

                                <% }) %>

                            </select>

                            <label>Days to Maturity</label>
                            <input
                                name="days_to_maturity"
                                type="number"
                                min="1"
                                step="1"
                                value="<%= crop.days_to_maturity %>"
                                required
                            >

                            <label>Expected Yield (kg/ha) - Optional</label>
                            <input
                                name="expected_yield_kg_ha"
                                type="number"
                                min="0.01"
                                step="0.01"
                                value="<%= crop.expected_yield_kg_ha ?? '' %>"
                            >

                            <button type="submit">
                                Save Changes
                            </button>

                        </form>

                    </td>
                </tr>

            <% }) %>

        </tbody>
    </table>

</body>
</html>
