<%- include('partials/header', { pageTitle: 'Plantings Records' }) %>

<main class="page" id="main">
    <h1>Plantings Records</h1>
    <div class="card">
        <h2>Add New Planting (Transactional)</h2>
        <% if (typeof error !== 'undefined' && error) { %><div class="error"><%= error %></div><% } %>
        <form action="/plantings/add" method="POST">
            <div class="field">
                <label>Select Idle Field:</label>
                <select name="field_id" required>
                    <option value="">-- Choose Idle Field --</option>
                    <% idleFields.forEach(f => { %>
                        <option value="<%= f.field_id %>"><%= f.field_name %></option>
                    <% }); %>
                </select>
            </div>
            <div class="field">
                <label>Select Crop:</label>
                <select name="crop_id" required>
                    <option value="">-- Choose Crop --</option>
                    <% crops.forEach(c => { %>
                        <option value="<%= c.crop_id %>"><%= c.crop_name %> (<%= c.days_to_maturity %> days)</option>
                    <% }); %>
                </select>
            </div>
            <div class="field">
                <label>Planting Date:</label>
                <input type="date" name="planting_date" required>
            </div>
            <p class="hint">* Expected harvest date is calculated automatically using crop maturity days. The planter is the logged-in user.</p>
            <button type="submit" class="btn">Add Planting &amp; Update Field Status</button>
        </form>
    </div>

    <h2>Existing Plantings</h2>
    <div class="wrap">
    <div class="table-wrap">
        <table>
            <thead>
                <tr><th>ID</th><th>Field</th><th>Crop</th><th>User</th><th>Planting Date</th><th>Expected Harvest</th><th>Status</th><th>Action</th></tr>
            </thead>
            <tbody>
            <% if (plantings && plantings.length > 0) { %>
                <% plantings.forEach(p => { %>
                    <tr>
                        <td><%= p.planting_id %></td>
                        <td><%= p.field_name %></td>
                        <td><%= p.crop_name %></td>
                        <td><%= p.planted_by_name || '-' %></td>
                        <td><%= p.planting_date %></td>
                        <td><%= p.expected_harvest_date %></td>
                        <td><%= p.status %></td>
                        <td>
                            <a href="/plantings/edit/<%= p.planting_id %>">Edit</a>
                            <form class="inline" action="/plantings/delete/<%= p.planting_id %>" method="POST" onsubmit="return confirm('Delete planting #<%= p.planting_id %>?')">
                                <button type="submit" class="del">Delete</button>
                            </form>
                        </td>
                    </tr>
                <% }); %>
            <% } else { %>
                <tr><td colspan="8">No planting records found.</td></tr>
            <% } %>
            </tbody>
        </table>
    </div>
    </div>
</main>

<%- include('partials/footer') %>
