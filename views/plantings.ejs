<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Plantings Records</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; background-color: #f9f9f9; color: #333; }
        h1, h2 { color: #2e7d32; }
        .card { background: #fff; padding: 15px; margin-bottom: 20px; border: 1px solid #ddd; border-radius: 5px; }
        label { font-weight: bold; margin-top: 8px; display: block; font-size: 13px; }
        input, select { display: block; width: 100%; padding: 8px; margin-top: 4px; margin-bottom: 10px; border: 1px solid #ddd; border-radius: 4px; box-sizing: border-box; }
        .wrap { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; background: #fff; }
        th, td { padding: 8px; border: 1px solid #ddd; text-align: left; white-space: nowrap; }
        th { background-color: #2e7d32; color: white; }
        a { color: #2e7d32; text-decoration: none; font-weight: bold; }
        .btn { background-color: #2e7d32; color: white; padding: 10px 15px; border: none; border-radius: 4px; cursor: pointer; width: 100%; }
        .del { background-color: #d32f2f; color: white; padding: 4px 10px; border: none; border-radius: 4px; cursor: pointer; }
        .error { background: #fdecea; color: #b71c1c; padding: 10px; border-radius: 4px; margin-bottom: 10px; }
        form.inline { display: inline; }
    </style>
</head>
<body>
    <h1>Plantings Records</h1>
    <a href="/">&larr; Back to Home</a>

    <div class="card">
        <h2>Add New Planting (Transactional)</h2>
        <% if (typeof error !== 'undefined' && error) { %><div class="error"><%= error %></div><% } %>
        <form action="/plantings/add" method="POST">
            <label>Select Idle Field:</label>
            <select name="field_id" required>
                <option value="">-- Choose Idle Field --</option>
                <% idleFields.forEach(f => { %>
                    <option value="<%= f.field_id %>"><%= f.field_name %></option>
                <% }); %>
            </select>
            <label>Select Crop:</label>
            <select name="crop_id" required>
                <option value="">-- Choose Crop --</option>
                <% crops.forEach(c => { %>
                    <option value="<%= c.crop_id %>"><%= c.crop_name %> (<%= c.days_to_maturity %> days)</option>
                <% }); %>
            </select>
            <label>Planting Date:</label>
            <input type="date" name="planting_date" required>
            <p style="font-size: 0.85em; color: gray;">* Expected harvest date is calculated automatically using crop maturity days. The planter is the logged-in user.</p>
            <button type="submit" class="btn">Add Planting &amp; Update Field Status</button>
        </form>
    </div>

    <h2>Existing Plantings</h2>
    <div class="wrap">
    <table>
        <thead>
            <tr><th>ID</th><th>Field</th><th>Crop</th><th>User</th><th>Planting Date</th><th>Expected Harvest</th><th>Status</th><th>Action</th></tr>
        </thead>
        <tbody>
        <% if (plantings && plantings.length > 0) { %>
            <% plantings.forEach(p => { %>
                <tr>
                    <td><%= p.planting_id %></td>
                    <td><%= p.field_name %></td>
                    <td><%= p.crop_name %></td>
                    <td><%= p.planted_by_name || '-' %></td>
                    <td><%= p.planting_date %></td>
                    <td><%= p.expected_harvest_date %></td>
                    <td><%= p.status %></td>
                    <td>
                        <a href="/plantings/edit/<%= p.planting_id %>">Edit</a>
                        <form class="inline" action="/plantings/delete/<%= p.planting_id %>" method="POST" onsubmit="return confirm('Delete planting #<%= p.planting_id %>?')">
                            <button type="submit" class="del">Delete</button>
                        </form>
                    </td>
                </tr>
            <% }); %>
        <% } else { %>
            <tr><td colspan="8" style="text-align:center;">No planting records found.</td></tr>
        <% } %>
        </tbody>
    </table>
    </div>
</body>
</html>
