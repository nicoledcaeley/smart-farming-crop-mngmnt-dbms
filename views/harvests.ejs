<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Harvest Entry</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; background-color: #f9f9f9; color: #333; }
        h1, h2, h3 { color: #2e7d32; }
        .card, form { background: #fff; padding: 15px; margin-bottom: 20px; border: 1px solid #ddd; border-radius: 5px; }
        label { font-weight: bold; margin-top: 8px; display: block; font-size: 13px; }
        input, select { display: block; width: 100%; padding: 8px; margin-top: 4px; margin-bottom: 10px; border: 1px solid #ddd; border-radius: 4px; box-sizing: border-box; }
        table { width: 100%; border-collapse: collapse; background: #fff; margin-top: 10px; }
        th, td { padding: 10px; border: 1px solid #ddd; text-align: left; }
        th { background-color: #2e7d32; color: white; }
        a { color: #2e7d32; text-decoration: none; }
        .btn { background-color: #2e7d32; color: white; padding: 10px 15px; border: none; border-radius: 4px; cursor: pointer; width: 100%; }
        .error { background: #fdecea; color: #b71c1c; padding: 10px; border-radius: 4px; margin-bottom: 10px; }
    </style>
</head>
<body>
    <a href="/">&larr; Back to Home</a>
    <h2>Harvest Entry (Transactional)</h2>
    <div class="card">
        <% if (typeof error !== 'undefined' && error) { %><div class="error"><%= error %></div><% } %>
        <form action="/harvests/add" method="POST">
            <label>Select Active Planting:</label>
            <select name="planting_id" required>
                <option value="">-- Select Active Planting --</option>
                <% plantings.forEach(p => { %>
                    <option value="<%= p.planting_id %>">Planting #<%= p.planting_id %> (planted <%= p.planting_date %>)</option>
                <% }); %>
            </select>
            <label>Harvest Date:</label>
            <input type="date" name="harvest_date" required>
            <label>Quantity (kg):</label>
            <input type="number" step="0.01" min="0.01" name="quantity_kg" placeholder="Enter quantity" required>
            <label>Quality Grade:</label>
            <select name="quality_grade" required>
                <option value="">-- Select Grade --</option>
                <option value="A">A</option>
                <option value="B">B</option>
                <option value="C">C</option>
            </select>
            <button type="submit" class="btn">Record Harvest &amp; Set Field Idle</button>
        </form>
    </div>
    <h3>Harvest Records</h3>
    <table>
        <thead><tr><th>ID</th><th>Planting ID</th><th>Harvest Date</th><th>Quantity (kg)</th><th>Grade</th></tr></thead>
        <tbody>
        <% harvests.forEach(h => { %>
            <tr>
                <td><%= h.harvest_id %></td>
                <td><%= h.planting_id %></td>
                <td><%= h.harvest_date %></td>
                <td><%= h.quantity_kg %> kg</td>
                <td><%= h.quality_grade %></td>
            </tr>
        <% }); %>
        </tbody>
    </table>
</body>
</html>
