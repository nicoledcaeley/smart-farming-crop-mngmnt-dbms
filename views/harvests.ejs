<%- include('partials/header', { pageTitle: 'Harvest Entry' }) %>

<main class="page" id="main">
    <h2>Harvest Entry (Transactional)</h2>
    <div class="card">
        <% if (typeof error !== 'undefined' && error) { %><div class="error"><%= error %></div><% } %>
        <form action="/harvests/add" method="POST">
            <div class="field">
                <label>Select Active Planting:</label>
                <select name="planting_id" required>
                    <option value="">-- Select Active Planting --</option>
                    <% plantings.forEach(p => { %>
                        <option value="<%= p.planting_id %>">Planting #<%= p.planting_id %> (planted <%= p.planting_date %>)</option>
                    <% }); %>
                </select>
            </div>
            <div class="field">
                <label>Harvest Date:</label>
                <input type="date" name="harvest_date" required>
            </div>
            <div class="field">
                <label>Quantity (kg):</label>
                <input type="number" step="0.01" min="0.01" name="quantity_kg" placeholder="Enter quantity" required>
            </div>
            <div class="field">
                <label>Quality Grade:</label>
                <select name="quality_grade" required>
                    <option value="">-- Select Grade --</option>
                    <option value="A">A</option>
                    <option value="B">B</option>
                    <option value="C">C</option>
                </select>
            </div>
            <button type="submit" class="btn">Record Harvest &amp; Set Field Idle</button>
        </form>
    </div>
    <h3>Harvest Records</h3>
    <div class="table-wrap">
        <table>
            <thead><tr><th>ID</th><th>Planting ID</th><th>Harvest Date</th><th>Quantity (kg)</th><th>Grade</th></tr></thead>
            <tbody>
            <% harvests.forEach(h => { %>
                <tr>
                    <td><%= h.harvest_id %></td>
                    <td><%= h.planting_id %></td>
                    <td><%= h.harvest_date %></td>
                    <td><%= h.quantity_kg %> kg</td>
                    <td><%= h.quality_grade %></td>
                </tr>
            <% }); %>
            </tbody>
        </table>
    </div>
</main>

<%- include('partials/footer') %>
