<%- include('partials/header', { pageTitle: '' }) %>

<main class="page" id="main">
            <h1>User Management</h1>
            <p>View registered users, their roles, farms, and account status.</p>
            <h2>Add New User</h2>

    <form action="/users" method="POST">
        <div class="field">
            <label>Full Name:</label>
            <input type="text" name="full_name" required minlength="2">
        </div>

        <div class="field">
            <label>Email:</label>
            <input type="email" name="email" required>
        </div>

        <div class="field">
            <label>Password:</label>
            <input type="password" name="password" required minlength="8">
        </div>

        <div class="field">
            <label>Role:</label>
            <select name="role_id" required>
                <option value="">Select Role</option>
                <% roles.forEach(role => { %>
                    <option value="<%= role.role_id %>">
                        <%= role.role_name %>
                    </option>
                <% }); %>
            </select>
        </div>

        <div class="field">
            <label>Farm:</label>
            <select name="farm_id">
                <option value="">No Farm Assigned</option>
                <% farms.forEach(farm => { %>
                    <option value="<%= farm.farm_id %>">
                        <%= farm.farm_name %>
                    </option>
                <% }); %>
            </select>
        </div>

        <button type="submit">Add User</button>
    </form>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Full Name</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th>Farm</th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        <% if (users.length === 0) { %>
                            <tr>
                                <td colspan="6">No users found.</td>
                            </tr>
                        <% } %>

                        <% users.forEach(user => { %>
                            <tr>
                                <td><%= user.user_id %></td>
                                <td><%= user.full_name %></td>
                                <td><%= user.email %></td>
                                <td><%= user.role_name %></td>
                                <td><%= user.farm_name || 'Not assigned' %></td>
                                <td class="<%= user.is_active ? 'active' : 'inactive' %>">
                                    <%= user.is_active ? 'Active' : 'Inactive' %>
                                </td>
                                <td>
                                    <a href="/users/edit/<%= user.user_id %>">Edit</a>
                                    <form action="/users/delete/<%= user.user_id %>" method="POST"
                                        onsubmit="return confirm('Are you sure you want to delete this user?');">
                                        <button type="submit">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
</main>

<%- include('partials/footer') %>
