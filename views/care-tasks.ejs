<%- include('partials/header', { pageTitle: 'Care Tasks' }) %>

<style>
    .action-buttons {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    .edit-button {
        background: #89a1c5;
        color: white;
        border: none;
        padding: 7px 12px;
        border-radius: 4px;
        cursor: pointer;
    }

    .delete-button {
        background: #fff;
        color: #b42318;
        border: 1px solid #f0b4ae;
        padding: 7px 12px;
        border-radius: 4px;
        cursor: pointer;
    }

    .modal {
        display: none;
        position: fixed;
        z-index: 1000;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        align-items: center;
        justify-content: center;
        padding: 16px;
    }

    .modal-content {
        background: white;
        color: #222;
        padding: 24px;
        border-radius: 8px;
        width: 100%;
        max-width: 450px;
        max-height: 90vh;
        overflow-y: auto;
    }

    .modal-content label {
        display: block;
        margin-top: 12px;
        margin-bottom: 5px;
    }

    .modal-content input,
    .modal-content select {
        box-sizing: border-box;
        width: 100%;
        padding: 9px;
    }

    .modal-actions {
        display: flex;
        gap: 10px;
        margin-top: 20px;
    }

    .modal-actions button {
        padding: 9px 14px;
        cursor: pointer;
    }
</style>

<main class="page" id="main">
    <h1>Care Tasks</h1>
    <p>Manage irrigation, fertilizing, pest control, weeding, and other farm tasks.</p>

    <h2>Create Care Task</h2>

    <form action="/care-tasks" method="POST">
        <div class="field">
            <label for="planting_id">Planting:</label>
            <select name="planting_id" id="planting_id" required>
                <option value="">Select a planting</option>
                <% plantings.forEach(function(planting) { %>
                    <option value="<%= planting.planting_id %>">
                        Planting #<%= planting.planting_id %> - <%= planting.crop_name %>
                    </option>
                <% }); %>
            </select>
        </div>

        <div class="field">
            <label for="task_type">Task Type:</label>
            <select name="task_type" id="task_type" required>
                <option value="Irrigation">Irrigation</option>
                <option value="Fertilizing">Fertilizing</option>
                <option value="Pest control">Pest control</option>
                <option value="Weeding">Weeding</option>
                <option value="Other">Other</option>
            </select>
        </div>

        <div class="field">
            <label for="due_date">Due Date:</label>
            <input type="date" name="due_date" id="due_date" required>
        </div>

        <div class="field">
            <label for="assigned_to">Assign To:</label>
            <select name="assigned_to" id="assigned_to">
                <option value="">Unassigned</option>
                <% users.forEach(function(user) { %>
                    <option value="<%= user.user_id %>">
                        <%= user.full_name %>
                    </option>
                <% }); %>
            </select>
        </div>

        <button type="submit">Create Task</button>
    </form>

    <h2>Existing Care Tasks</h2>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>Task ID</th>
                    <th>Planting</th>
                    <th>Crop</th>
                    <th>Task Type</th>
                    <th>Due Date</th>
                    <th>Status</th>
                    <th>Update Status</th>
                    <th>Source</th>
                    <th>Assigned To</th>
                    <th>Skip Reason</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>
                <% if (tasks.length === 0) { %>
                    <tr>
                        <td colspan="11">No care tasks found.</td>
                    </tr>
                <% } else { %>
                    <% tasks.forEach(function(task) { %>
                        <tr>
                            <td><%= task.task_id %></td>
                            <td><%= task.planting_id %></td>
                            <td><%= task.crop_name || 'Unknown crop' %></td>
                            <td><%= task.task_type %></td>

                            <td>
                                <%= task.due_date instanceof Date
                                    ? `${task.due_date.getFullYear()}-${String(task.due_date.getMonth() + 1).padStart(2, '0')}-${String(task.due_date.getDate()).padStart(2, '0')}`
                                    : String(task.due_date).slice(0, 10) %>
                            </td>

                            <td><%= task.status %></td>

                            <td>
                                <form action="/care-tasks/<%= task.task_id %>/status"
                                      method="POST">
                                    <select name="status" required>
                                        <option value="Pending"
                                            <%= task.status === 'Pending' ? 'selected' : '' %>>
                                            Pending
                                        </option>
                                        <option value="Done"
                                            <%= task.status === 'Done' ? 'selected' : '' %>>
                                            Done
                                        </option>
                                        <option value="Skipped"
                                            <%= task.status === 'Skipped' ? 'selected' : '' %>>
                                            Skipped
                                        </option>
                                        <option value="Overdue"
                                            <%= task.status === 'Overdue' ? 'selected' : '' %>>
                                            Overdue
                                        </option>
                                    </select>
                                    <button type="submit">Update</button>
                                </form>
                            </td>

                            <td><%= task.source || '-' %></td>
                            <td><%= task.assigned_name || 'Unassigned' %></td>
                            <td><%= task.skip_reason || '-' %></td>

                            <td>
                                <div class="action-buttons">
                                    <button
                                        type="button"
                                        class="edit-button"
                                        onclick="openEditTask(this)"
                                        data-task-id="<%= task.task_id %>"
                                        data-planting-id="<%= task.planting_id %>"
                                        data-task-type="<%= task.task_type %>"
                                        data-due-date="<%= task.due_date instanceof Date
                                            ? `${task.due_date.getFullYear()}-${String(task.due_date.getMonth() + 1).padStart(2, '0')}-${String(task.due_date.getDate()).padStart(2, '0')}`
                                            : String(task.due_date).slice(0, 10) %>"
                                        data-assigned-to="<%= task.assigned_to || '' %>">
                                        Edit
                                    </button>

                                    <form
                                        action="/care-tasks/<%= task.task_id %>/delete"
                                        method="POST"
                                        onsubmit="return confirm('Are you sure you want to delete this care task?');">
                                        <button type="submit" class="delete-button">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                <% } %>
            </tbody>
        </table>
    </div>

    <div id="editTaskModal" class="modal">
        <div class="modal-content">
            <h2>Edit Care Task</h2>

            <form id="editTaskForm" method="POST">
                <label for="edit_planting_id">Planting:</label>
                <select name="planting_id" id="edit_planting_id" required>
                    <% plantings.forEach(function(planting) { %>
                        <option value="<%= planting.planting_id %>">
                            Planting #<%= planting.planting_id %> - <%= planting.crop_name %>
                        </option>
                    <% }); %>
                </select>

                <label for="edit_task_type">Task Type:</label>
                <select name="task_type" id="edit_task_type" required>
                    <option value="Irrigation">Irrigation</option>
                    <option value="Fertilizing">Fertilizing</option>
                    <option value="Pest control">Pest control</option>
                    <option value="Weeding">Weeding</option>
                    <option value="Other">Other</option>
                </select>

                <label for="edit_due_date">Due Date:</label>
                <input type="date" name="due_date" id="edit_due_date" required>

                <label for="edit_assigned_to">Assign To:</label>
                <select name="assigned_to" id="edit_assigned_to">
                    <option value="">Unassigned</option>
                    <% users.forEach(function(user) { %>
                        <option value="<%= user.user_id %>">
                            <%= user.full_name %>
                        </option>
                    <% }); %>
                </select>

                <div class="modal-actions">
                    <button type="submit">Save Changes</button>
                    <button type="button" onclick="closeEditTask()">Cancel</button>
                </div>
            </form>
        </div>
    </div>
</main>

<script>
    function openEditTask(button) {
        const taskId = button.dataset.taskId;

        document.getElementById('editTaskForm').action =
            '/care-tasks/' + taskId + '/update';

        document.getElementById('edit_planting_id').value =
            button.dataset.plantingId;

        document.getElementById('edit_task_type').value =
            button.dataset.taskType;

        document.getElementById('edit_due_date').value =
            button.dataset.dueDate;

        document.getElementById('edit_assigned_to').value =
            button.dataset.assignedTo;

        document.getElementById('editTaskModal').style.display = 'flex';
    }

    function closeEditTask() {
        document.getElementById('editTaskModal').style.display = 'none';
    }

    document.getElementById('editTaskModal').addEventListener('click', function(event) {
        if (event.target === this) {
            closeEditTask();
        }
    });
</script>

<%- include('partials/footer') %>