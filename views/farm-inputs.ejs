<%- include('partials/header', { pageTitle: 'Farm Inputs Management' }) %>

<main class="page" id="main">
    <h1>Farm Inputs Management</h1>

    <% if (error) { %>
        <p class="error"><%= error %></p>
    <% } %>

    <h2>Add Farm Input</h2>

    <form action="/farm-inputs" method="POST">

        <div class="field">
            <label for="input_name">Input Name</label>
            <input
                id="input_name"
                name="input_name"
                maxlength="100"
                required
            >
        </div>

        <div class="field">
            <label for="input_type">Input Type</label>
            <select id="input_type" name="input_type" required>
                <option value="">Select type</option>
                <option>Seed</option>
                <option>Fertilizer</option>
                <option>Pesticide</option>
                <option>Other</option>
            </select>
        </div>

        <div class="field">
            <label for="unit">Unit</label>
            <input
                id="unit"
                name="unit"
                maxlength="20"
                placeholder="e.g. kg, sack, L"
                required
            >
        </div>

        <div class="field">
            <label for="stock_qty">Stock Quantity</label>
            <input
                id="stock_qty"
                name="stock_qty"
                type="number"
                min="0"
                step="0.01"
                required
            >
        </div>

        <div class="field">
            <label for="reorder_level">Reorder Level</label>
            <input
                id="reorder_level"
                name="reorder_level"
                type="number"
                min="0"
                step="0.01"
                required
            >
        </div>

        <button type="submit">Add Input</button>

    </form>

    <h2>Existing Farm Inputs</h2>

    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Input Name</th>
                    <th>Type</th>
                    <th>Unit</th>
                    <th>Stock</th>
                    <th>Reorder Level</th>
                    <th>Status</th>
    <% if (sessionUser && ['Admin', 'Farm Manager'].includes(sessionUser.role_name)) { %>
        <th>Actions</th>
    <% } %>
                </tr>
            </thead>

            <tbody>

                <% inputs.forEach(input => { %>

                    <tr>
                        <td><%= input.input_id %></td>
                        <td><%= input.input_name %></td>
                        <td><%= input.input_type %></td>
                        <td><%= input.unit %></td>
                        <td><%= input.stock_qty %></td>
                        <td><%= input.reorder_level %></td>

                        <td>
                            <% if (input.low_stock) { %>
                                <span class="low-stock">Low Stock</span>
                            <% } else { %>
                                <span class="normal-stock">Sufficient</span>
                            <% } %>
                        </td>
    <% if (sessionUser && ['Admin', 'Farm Manager'].includes(sessionUser.role_name)) { %>
                        <td>
                            <button
                                type="button"
                                onclick="document.getElementById('edit-<%= input.input_id %>').hidden = !document.getElementById('edit-<%= input.input_id %>').hidden">
                                Edit
                            </button>

                            <form
                                action="/farm-inputs/<%= input.input_id %>/delete"
                                method="POST"
                                onsubmit="return confirm('Delete this farm input?');">

                                <button type="submit">Delete</button>

                            </form>
    </td>
    <% } %>
    </tr>
    <% if (sessionUser && ['Admin', 'Farm Manager'].includes(sessionUser.role_name)) { %>
    <tr id="edit-<%= input.input_id %>" hidden>

                        <td colspan="8">

                            <form
                                action="/farm-inputs/<%= input.input_id %>/update"
                                method="POST">

                                <div class="field">
                                    <label>Input Name</label>
                                    <input
                                        name="input_name"
                                        value="<%= input.input_name %>"
                                        maxlength="100"
                                        required
                                    >
                                </div>

                                <div class="field">
                                    <label>Input Type</label>
                                    <select name="input_type" required>

                                        <% ['Seed', 'Fertilizer', 'Pesticide', 'Other'].forEach(type => { %>

                                            <option
                                                value="<%= type %>"
                                                <%= type === input.input_type ? 'selected' : '' %>>
                                                <%= type %>
                                            </option>

                                        <% }) %>

                                    </select>
                                </div>

                                <div class="field">
                                    <label>Unit</label>
                                    <input
                                        name="unit"
                                        value="<%= input.unit %>"
                                        maxlength="20"
                                        required
                                    >
                                </div>

                                <div class="field">
                                    <label>Stock Quantity</label>
                                    <input
                                        name="stock_qty"
                                        type="number"
                                        min="0"
                                        step="0.01"
                                        value="<%= input.stock_qty %>"
                                        required
                                    >
                                </div>

                                <div class="field">
                                    <label>Reorder Level</label>
                                    <input
                                        name="reorder_level"
                                        type="number"
                                        min="0"
                                        step="0.01"
                                        value="<%= input.reorder_level %>"
                                        required
                                    >
                                </div>

                                <button type="submit">Save Changes</button>

                            </form>

                        </td>
                    </tr>

    <% } %>

                <% }) %>

            </tbody>
        </table>
    </div>
</main>

<%- include('partials/footer') %>
