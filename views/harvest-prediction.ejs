<%- include('partials/header', { pageTitle: 'Harvest Prediction' }) %>

<main class="page" id="main">
    <h1>Harvest Prediction</h1>
    <p>Estimated harvest dates for your active plantings.</p>

    <div class="table-container">
        <% if (predictions.length === 0) { %>
            <p class="empty">No active plantings found.</p>
        <% } else { %>
            <div class="table-wrap">
                <table>
                    <thead>
                        <tr>
                            <th>Planting ID</th>
                            <th>Crop</th>
                            <th>Planting Date</th>
                            <th>Predicted Harvest</th>
                            <th>Days Remaining</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% predictions.forEach(function(item) { %>
                            <tr>
                                <td><%= item.planting_id %></td>
                                <td><%= item.crop_name %></td>
                                <td><%= new Date(item.planting_date).toLocaleDateString() %></td>
                                <td><%= new Date(item.predicted_harvest_date).toLocaleDateString() %></td>
                                <td>
                                    <%= Math.max(0, item.days_remaining) %>
                                </td>
                                <td class="<%= item.days_remaining <= 0 ? 'ready' : 'growing' %>">
                                    <%= item.harvest_status %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        <% } %>

        </div>
</main>

<%- include('partials/footer') %>
