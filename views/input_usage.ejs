<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Input Usage</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; background-color: #f9f9f9; color: #333; }
        h2, h3 { color: #2e7d32; }
        .card { background: #fff; padding: 15px; margin-bottom: 20px; border: 1px solid #ddd; border-radius: 5px; }
        label { font-weight: bold; margin-top: 8px; display: block; font-size: 13px; }
        input, select { display: block; width: 100%; padding: 8px; margin-top: 4px; margin-bottom: 10px; border: 1px solid #ddd; border-radius: 4px; box-sizing: border-box; }
        table { width: 100%; border-collapse: collapse; background: #fff; margin-top: 10px; }
        th, td { padding: 10px; border: 1px solid #ddd; text-align: left; }
        th { background-color: #2e7d32; color: white; }
        a { color: #2e7d32; text-decoration: none; }
        .btn { background-color: #2e7d32; color: white; padding: 10px 15px; border: none; border-radius: 4px; cursor: pointer; width: 100%; }
        .error { background: #fdecea; color: #b71c1c; padding: 10px; border-radius: 4px; margin-bottom: 10px; }
    </style>
</head>
<body>
    <a href="/">&larr; Back to Home</a>
    <h2>Input Usage Entry (Transactional)</h2>
    <div class="card">
        <% if (typeof error !== 'undefined' && error) { %><div class="error"><%= error %></div><% } %>
        <form action="/input-usage/add" method="POST">
            <label>Select Active Planting:</label>
            <select name="planting_id" required>
                <option value="">-- Select Planting --</option>
                <% plantings.forEach(p => { %>
                    <option value="<%= p.planting_id %>">#<%= p.planting_id %> - <%= p.field_name %> (<%= p.crop_name %>)</option>
                <% }); %>
            </select>
            <label>Select Farm Input:</label>
            <select name="input_id" required>
                <option value="">-- Select Input --</option>
                <% farmInputs.forEach(i => { %>
                    <option value="<%= i.input_id %>"><%= i.input_name %> (stock: <%= i.stock_qty %> <%= i.unit %>)</option>
                <% }); %>
            </select>
            <label>Quantity Used:</label>
            <input type="number" step="0.01" min="0.01" name="quantity_used" placeholder="Enter quantity" required>
            <label>Date Used:</label>
            <input type="date" name="usage_date" required>
            <button type="submit" class="btn">Record Usage &amp; Deduct Stock</button>
        </form>
    </div>
    <h3>Input Usage Records</h3>
    <table>
        <thead><tr><th>ID</th><th>Planting</th><th>Input</th><th>Quantity</th><th>Date</th></tr></thead>
        <tbody>
        <% usages.forEach(u => { %>
            <tr>
                <td><%= u.usage_id %></td>
                <td><%= u.planting_id %></td>
                <td><%= u.input_name %></td>
                <td><%= u.quantity_used %> <%= u.unit %></td>
                <td><%= u.usage_date %></td>
            </tr>
        <% }); %>
        </tbody>
    </table>
</body>
</html>
