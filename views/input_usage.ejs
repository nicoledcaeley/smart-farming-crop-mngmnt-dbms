<!DOCTYPE html>
<html>
<head>
    <title>Input Usage Entry</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; background-color: #f9f9f9; color: #333; }
        h1, h2, h3 { color: #2e7d32; }
        .card, form { background: #fff; padding: 15px; margin-bottom: 20px; border: 1px solid #ddd; border-radius: 5px; }
        label { font-weight: bold; margin-top: 8px; display: block; font-size: 13px; }
        input, select { display: block; width: 100%; padding: 8px; margin-top: 4px; margin-bottom: 10px; border: 1px solid #ddd; border-radius: 4px; box-sizing: border-box; }
        table { width: 100%; border-collapse: collapse; background: #fff; margin-top: 10px; }
        th, td { padding: 10px; border: 1px solid #ddd; text-align: left; }
        th { background-color: #2e7d32; color: white; }
        a { color: #2e7d32; text-decoration: none; }
        a:hover { text-decoration: underline; }
        .btn { background-color: #2e7d32; color: white; padding: 10px 15px; border: none; border-radius: 4px; cursor: pointer; display: inline-block; width: 100%; }
        .btn:hover { background-color: #1b5e20; }
    </style>
</head>
<body>
    <a href="/">&larr; Back to Home</a>
    <h2>Input Usage Entry (Transactional)</h2>

    <div class="card">
        <form action="/input-usage/add" method="POST">
            <div>
                <label>Select Planting:</label>
                <select name="planting_id" required>
                    <option value="">-- Select Planting --</option>
                    <% plantings.forEach(p => { %>
                        <option value="<%= p.planting_id %>">
                            ID: <%= p.planting_id %> - <%= p.field_name %> (<%= p.crop_name %>)
                        </option>
                    <% }); %>
                </select>
            </div>
            <div>
                <label>Select Farm Input:</label>
                <select name="input_id" required>
                    <option value="">-- Select Input --</option>
                    <% farmInputs.forEach(i => { %>
                        <option value="<%= i.input_id %>">
                            <%= i.input_name %> (Available Stock: <%= i.stock_qty %>)
                        </option>
                    <% }); %>
                </select>
            </div>
            <div>
                <label>Quantity Used:</label>
                <input type="number" step="0.01" name="quantity_used" placeholder="Enter quantity" required>
            </div>
            <div>
                <label>Date Used:</label>
                <input type="date" name="date_used" required>
            </div>
            <button type="submit" class="btn">Record Usage & Deduct Stock</button>
        </form>
    </div>

    <h3>Input Usage Records</h3>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Planting ID</th>
                <th>Input ID</th>
                <th>Quantity Used</th>
                <th>Date Used</th>
            </tr>
        </thead>
        <tbody>
            <% usageRecords.forEach(u => { %>
                <tr>
                    <td><%= u.usage_id %></td>
                    <td><%= u.planting_id %></td>
                    <td><%= u.input_name || u.input_id %></td>
                    <td><%= u.quantity_used %></td>
                    <td><%= u.date_used %></td>
                </tr>
            <% }); %>
        </tbody>
    </table>
</body>
</html>
