<%- include('partials/header', { pageTitle: 'Input Usage' }) %>

<main class="page" id="main">
    <h2>Input Usage Entry (Transactional)</h2>
    <div class="card">
        <% if (typeof error !== 'undefined' && error) { %><div class="error"><%= error %></div><% } %>
        <form action="/input-usage/add" method="POST">
            <div class="field">
                <label>Select Active Planting:</label>
                <select name="planting_id" required>
                    <option value="">-- Select Planting --</option>
                    <% plantings.forEach(p => { %>
                        <option value="<%= p.planting_id %>">#<%= p.planting_id %> - <%= p.field_name %> (<%= p.crop_name %>)</option>
                    <% }); %>
                </select>
            </div>
            <div class="field">
                <label>Select Farm Input:</label>
                <select name="input_id" required>
                    <option value="">-- Select Input --</option>
                    <% farmInputs.forEach(i => { %>
                        <option value="<%= i.input_id %>"><%= i.input_name %> (stock: <%= i.stock_qty %> <%= i.unit %>)</option>
                    <% }); %>
                </select>
            </div>
            <div class="field">
                <label>Quantity Used:</label>
                <input type="number" step="0.01" min="0.01" name="quantity_used" placeholder="Enter quantity" required>
            </div>
            <div class="field">
                <label>Date Used:</label>
                <input type="date" name="usage_date" required>
            </div>
            <button type="submit" class="btn">Record Usage &amp; Deduct Stock</button>
        </form>
    </div>
    <h3>Input Usage Records</h3>
    <div class="table-wrap">
        <table>
            <thead><tr><th>ID</th><th>Planting</th><th>Input</th><th>Quantity</th><th>Date</th></tr></thead>
            <tbody>
            <% usages.forEach(u => { %>
                <tr>
                    <td><%= u.usage_id %></td>
                    <td><%= u.planting_id %></td>
                    <td><%= u.input_name %></td>
                    <td><%= u.quantity_used %> <%= u.unit %></td>
                    <td><%= u.usage_date %></td>
                </tr>
            <% }); %>
            </tbody>
        </table>
    </div>
</main>

<%- include('partials/footer') %>
