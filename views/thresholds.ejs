<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crop Thresholds</title>
    <link rel="stylesheet" href="/style.css">

    <style>
        .actions {
            display: flex;
            gap: 8px;
            align-items: center;
        }

        .edit-btn,
        .delete-btn,
        .save-btn,
        .cancel-btn {
            padding: 8px 16px;
            border-radius: 6px;
            font-size: 14px;
            font-weight: 500;
            cursor: pointer;
            transition: background-color 0.2s ease, border-color 0.2s ease;
        }

        .edit-btn,
        .cancel-btn {
            background: #fff;
            color: #374151;
            border: 1px solid #d1d5db;
        }

        .edit-btn:hover,
        .cancel-btn:hover {
            background: #f3f4f6;
            border-color: #9ca3af;
        }

        .delete-btn {
            background: #fff;
            color: #b42318;
            border: 1px solid #f0b4ae;
        }

        .delete-btn:hover {
            background: #fef2f2;
            border-color: #d92d20;
        }

        .save-btn {
            background: #2563eb;
            color: #fff;
            border: 1px solid #2563eb;
        }

        .save-btn:hover {
            background: #1d4ed8;
        }

        .modal {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 1000;
            background: rgba(17, 24, 39, 0.55);
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .modal-content {
            background: #fff;
            width: 100%;
            max-width: 480px;
            max-height: 90vh;
            overflow-y: auto;
            padding: 28px;
            border-radius: 10px;
            box-shadow: 0 15px 40px rgba(0, 0, 0, 0.15);
        }

        .modal-content h2 {
            margin: 0 0 8px;
            color: #111827;
        }

        .modal-description {
            margin-bottom: 24px;
            color: #6b7280;
            font-size: 14px;
        }

        .modal-content label {
            display: block;
            margin: 14px 0 6px;
            font-weight: 500;
            color: #374151;
        }

        .modal-content input,
        .modal-content select {
            box-sizing: border-box;
            width: 100%;
            padding: 10px 12px;
            border: 1px solid #d1d5db;
            border-radius: 6px;
            font-size: 14px;
        }

        .modal-content input:focus,
        .modal-content select:focus {
            outline: 2px solid #bfdbfe;
            border-color: #2563eb;
        }

        .modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 24px;
        }

        @media (max-width: 600px) {
            .actions {
                flex-wrap: wrap;
            }

            .modal-content {
                padding: 20px;
            }
        }
    </style>
</head>

<body>
    <h1>Crop Thresholds</h1>
    <p>Manage the minimum and maximum values for each crop metric.</p>

    <p><a href="/">Back to Home</a></p>

    <h2>Add Crop Threshold</h2>

    <form action="/thresholds" method="POST">
        <label for="crop_id">Crop:</label>
        <select name="crop_id" id="crop_id" required>
            <option value="">Select a crop</option>
            <% crops.forEach(function(crop) { %>
                <option value="<%= crop.crop_id %>">
                    <%= crop.crop_name %>
                </option>
            <% }); %>
        </select>

        <label for="metric">Metric:</label>
        <select name="metric" id="metric" required>
            <option value="">Select a metric</option>
            <option value="soil_moisture">Soil Moisture</option>
            <option value="temperature">Temperature</option>
            <option value="ph">pH</option>
        </select>

        <label for="min_value">Minimum Value:</label>
        <input type="number" id="min_value" name="min_value"
               step="0.01" required>

        <label for="max_value">Maximum Value:</label>
        <input type="number" id="max_value" name="max_value"
               step="0.01" required>

        <button type="submit">Add Threshold</button>
    </form>

    <h2>Existing Crop Thresholds</h2>

    <table>
        <thead>
            <tr>
                <th>Crop</th>
                <th>Metric</th>
                <th>Minimum</th>
                <th>Maximum</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            <% thresholds.forEach(function(threshold) { %>
                <tr>
                    <td><%= threshold.crop_name %></td>
                    <td><%= threshold.metric %></td>
                    <td><%= threshold.min_value %></td>
                    <td><%= threshold.max_value %></td>
                    <td>
                        <div class="actions">
                            <button
                                type="button"
                                class="edit-btn"
                                data-id="<%= threshold.threshold_id %>"
                                data-crop-id="<%= threshold.crop_id %>"
                                data-metric="<%= threshold.metric %>"
                                data-min-value="<%= threshold.min_value %>"
                                data-max-value="<%= threshold.max_value %>"
                                onclick="openEditModal(this)">
                                Edit
                            </button>

                            <form
                                action="/thresholds/<%= threshold.threshold_id %>/delete"
                                method="POST"
                                onsubmit="return confirm('Are you sure you want to delete this crop threshold?');">
                                <button type="submit" class="delete-btn">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </td>
                </tr>
            <% }); %>
        </tbody>
    </table>

    <div
        id="editModal"
        class="modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="editModalTitle"
        onclick="closeModalOnBackdrop(event)">

        <div class="modal-content">
            <h2 id="editModalTitle">Edit Crop Threshold</h2>
            <p class="modal-description">
                Update the crop and its minimum and maximum metric values.
            </p>

            <form id="editForm" method="POST">
                <label for="edit_crop_id">Crop:</label>
                <select name="crop_id" id="edit_crop_id" required>
                    <% crops.forEach(function(crop) { %>
                        <option value="<%= crop.crop_id %>">
                            <%= crop.crop_name %>
                        </option>
                    <% }); %>
                </select>

                <label for="edit_metric">Metric:</label>
                <select name="metric" id="edit_metric" required>
                    <option value="soil_moisture">Soil Moisture</option>
                    <option value="temperature">Temperature</option>
                    <option value="ph">pH</option>
                </select>

                <label for="edit_min_value">Minimum Value:</label>
                <input type="number" id="edit_min_value"
                       name="min_value" step="0.01" required>

                <label for="edit_max_value">Maximum Value:</label>
                <input type="number" id="edit_max_value"
                       name="max_value" step="0.01" required>

                <div class="modal-actions">
                    <button type="button" class="cancel-btn"
                            onclick="closeEditModal()">
                        Cancel
                    </button>

                    <button type="submit" class="save-btn">
                        Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openEditModal(button) {
            const modal = document.getElementById('editModal');
            const form = document.getElementById('editForm');

            form.action =
                '/thresholds/' + button.dataset.id + '/update';

            document.getElementById('edit_crop_id').value =
                button.dataset.cropId;

            document.getElementById('edit_metric').value =
                button.dataset.metric;

            document.getElementById('edit_min_value').value =
                button.dataset.minValue;

            document.getElementById('edit_max_value').value =
                button.dataset.maxValue;

            modal.style.display = 'flex';
            document.getElementById('edit_crop_id').focus();
        }

        function closeEditModal() {
            document.getElementById('editModal').style.display = 'none';
        }

        function closeModalOnBackdrop(event) {
            if (event.target === document.getElementById('editModal')) {
                closeEditModal();
            }
        }

        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                closeEditModal();
            }
        });
    </script>
</body>
</html>