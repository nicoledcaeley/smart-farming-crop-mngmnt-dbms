<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Edit Planting</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; background-color: #f9f9f9; color: #333; }
        h2 { color: #2e7d32; }
        form { background: #fff; padding: 15px; border: 1px solid #ddd; border-radius: 5px; max-width: 500px; }
        label { font-weight: bold; font-size: 13px; }
        input, select { display: block; width: 100%; padding: 8px; margin-top: 4px; margin-bottom: 10px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box; }
        button { background-color: #2e7d32; color: white; padding: 10px 15px; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; width: 100%; }
        a { display: inline-block; margin-top: 15px; text-decoration: none; color: #2e7d32; font-weight: bold; }
        .error { background: #fdecea; color: #b71c1c; padding: 10px; border-radius: 4px; margin-bottom: 10px; }
    </style>
</head>
<body>
    <h2>Edit Planting #<%= planting.planting_id %></h2>
    <form action="/plantings/update/<%= planting.planting_id %>" method="POST">
        <% if (typeof error !== 'undefined' && error) { %><div class="error"><%= error %></div><% } %>
        <label>Field:</label>
        <input type="text" value="<%= planting.field_name %>" disabled>
        <label>Crop:</label>
        <select name="crop_id" required>
            <% crops.forEach(c => { %>
                <option value="<%= c.crop_id %>" <%= c.crop_id === planting.crop_id ? 'selected' : '' %>><%= c.crop_name %></option>
            <% }); %>
        </select>
        <label>Planting Date:</label>
        <input type="date" name="planting_date" value="<%= planting.planting_date %>" required>
        <label>Expected Harvest Date:</label>
        <input type="date" name="expected_harvest_date" value="<%= planting.expected_harvest_date || '' %>">
        <label>Status:</label>
        <select name="status" required>
            <% ['Active', 'Harvested', 'Failed'].forEach(s => { %>
                <option value="<%= s %>" <%= planting.status === s ? 'selected' : '' %>><%= s %></option>
            <% }); %>
        </select>
        <button type="submit">Update Planting</button>
    </form>
    <a href="/plantings">&larr; Back to Plantings</a>
</body>
</html>
